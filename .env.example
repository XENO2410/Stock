# =========================================================================
# Personal Intraday Trading Assistant - Environment Configuration
# =========================================================================
# Copy this file to `.env` and edit values for your environment.
# The application ships with sensible defaults for demo mode.

# ---------------- Backend ----------------
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_SECRET_KEY=change-me-in-production-please
API_HOST=0.0.0.0
API_PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------- Database ----------------
# Use "sqlite" for zero-setup local dev, "postgres" via docker-compose.
DB_DIALECT=sqlite
DATABASE_URL=sqlite:///./data/trading.db
# For postgres, set:
# DB_DIALECT=postgres
# DATABASE_URL=postgresql+psycopg://trader:trader@postgres:5432/trading

# ---------------- Redis (optional) ----------------
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=false

# ---------------- Market data provider ----------------
# One of: demo | kite | groww
DATA_PROVIDER=demo

# Zerodha Kite (only used when DATA_PROVIDER=kite)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Groww (only used when DATA_PROVIDER=groww)
# Recommended: put your API Key + Secret here and the app will auto-refresh
# the access token daily using the checksum flow. If you prefer to paste an
# already-generated access token (resets 06:00 IST daily), set GROWW_ACCESS_TOKEN
# and leave the secret blank.
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=

# ---------------- Mock market tuning ----------------
MOCK_TICK_INTERVAL_MS=500
MOCK_DEPTH_LEVELS=25
MOCK_SEED=42

# ---------------- Frontend ----------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=Trading Assistant
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
